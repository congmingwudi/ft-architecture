  end

  subgraph AWS["AWS - account «account» - us-west-2"]
    APIGW["API Gateway HTTP API - flowpay-api<br/>$default stage - Lambda proxy integration<br/>«api-id».execute-api.us-west-2.amazonaws.com"]
    LAM["Lambda flowpay-api<br/>python3.12 - arm64 - 512 MB - 15 s<br/>FastAPI via Mangum - FLOWPAY_STORE=dynamodb"]
