flowchart LR
  %% diagram: gateway
  %% Laid out to mirror `gateway-gcp` so the two can be read side by side on the
  %% site: LR, three flat sibling clusters (laptop / IdP / cloud), the network hop
  %% as a free node between them, and inference splitting into a residency node and
  %% a retention node. EC2 is deliberately NOT a nested subgraph — nesting it inside
  %% the region cluster is what made this diagram 2445px tall at aspect 1.05 against
  %% the GCP one's 1.45. Its identity lives in the gateway node's own label instead,
  %% which is where the GCP diagram carries "Cloud Run ingress internal, or GKE".

  subgraph LAPTOP["Developer laptop - what the developer actually holds"]
    CC["<b>Claude Code</b><br/>an IdP session, and nothing else<br/><b>no AWS credential on this machine</b>"]
    MS["managed-settings.json<br/>forceLoginMethod - forceLoginGatewayUrl<br/><i>managed-only keys: MDM pushes these,<br/>a developer cannot set them</i>"]
    LOCALGW["<i>fallback - the same binary, run here</i><br/>127.0.0.1:8080, Homebrew postgres<br/><i>switching is one URL in managed settings</i>"]
    MS --> CC
  end

  subgraph AWSW["AWS us-west-2 - the identity provider"]
    COG["<b>1 · 2 - sign in, session minted</b><br/>Cognito user pool - OIDC<br/>hosted-UI domain, authorization code flow<br/>scopes: openid, profile, email<br/><i>email_verified=true gates sign-in</i>"]
  end

  TSNET["<b>3 - reaching the gateway</b><br/>Tailscale tailnet - WireGuard<br/>claude-gateway.«tailnet».ts.net<br/>Let's Encrypt cert, issued by Tailscale<br/><i>/login refuses plain HTTP off-loopback,<br/>even on RFC1918 - this is the fix</i>"]

  subgraph AWSE["AWS us-east-1 - account «account»"]
    SSMP["<b>SSM Parameter Store</b> - SecureString<br/>/claude-gateway/*<br/>OIDC issuer · client id · client secret<br/>JWT key · Tailscale auth key<br/><i>read at service start, never in user-data</i>"]
    IAMP["<b>IAM instance profile</b> - no static keys<br/>bedrock:InvokeModel* / Converse*<br/>ssm:GetParameter on /claude-gateway/* only<br/>kms:Decrypt conditioned on ssm ViaService"]
    GW["<b>claude gateway</b> - systemd unit<br/>EC2 t4g.small · AL2023 arm64<br/>«instance»<br/>binary from the signed dnf repo, so it<br/>cannot update itself under a demo<br/>listen 127.0.0.1:8080<br/>tailscaled subnet router - 172.31.0.0/20"]
    PG["<b>postgresql 16</b> - local to the box<br/>sessions, spend limits, audit<br/><i>password generated on the box into<br/>/etc/claude-gateway/pgpass (0600) - never leaves it</i>"]
    BR["<b>4 - inference · Amazon Bedrock</b><br/>bedrock-runtime<br/>us.anthropic.claude-opus-4-6-v1<br/>us.anthropic.claude-sonnet-4-6<br/>us.anthropic.claude-haiku-4-5<br/><i>the AWS default credential chain -<br/>no key is copied anywhere</i>"]
    RES["<b>Residency - one word</b><br/>us. is the US geo profile, <b>10%</b> premium<br/>global. is the same line at list price<br/><i>swapping one prefix in gateway.yaml<br/>is the entire residency decision</i>"]
    ZDR["<b>Retention - mode none</b><br/>nothing written to durable storage by AWS,<br/>nothing shared with the model provider<br/><b>set and re-read on all four cells, 2026-08-23:</b><br/>bedrock-runtime + bedrock-mantle,<br/>us-east-1 + us-west-2<br/><i>per region AND per control plane · proved by API</i>"]
    SSMP -.-> GW
    IAMP -.-> GW
    GW --> PG
    GW ==> BR
    BR --> RES
    BR --> ZDR
  end

  CC ==> COG
  CC ==> TSNET
  TSNET ==> GW

SGN["Security group - <b>zero inbound rules</b><br/>no SSH port, no key pair, nothing exposed<br/>administration is SSM Session Manager"]
  POL["<b>Policy, enforced server-side</b><br/>availableModels + enforceAvailableModels<br/>permissions.deny · desktop: {}<br/>keyed on IdP group, at the managed tier<br/><b>identical to GCP - the claude binary,<br/>not the cloud</b>"]
  AUD["<b>Audit</b> - one JSON line each<br/>device.authorize · session.mint<br/>managed.serve · inference<br/><b>the only per-developer record</b> - CloudTrail<br/>sees one instance role"]
  GW --> POL
  GW --> AUD
  POL -.-> CC

  DIFF["<b>What differs at FinTechCo</b><br/>Cognito to Okta or Entra - one oidc: block<br/>single EC2 to Fargate + RDS + ALB<br/>Tailscale MagicDNS to an internal ALB + ACM<br/><i>same security properties; a single box gives<br/>up availability, not posture</i>"]

  style POL fill:#f6f4ff
  style AUD fill:#f6f4ff
  style DIFF fill:#f6f4ff
  style SGN fill:#f6f4ff
  style RES fill:#fff7ed
  style ZDR fill:#fff7ed
  classDef fallback stroke-dasharray:5;
  class LOCALGW fallback;
